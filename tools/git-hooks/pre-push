#!/usr/bin/env bash
# Second line of defence (catches `git commit --no-verify`): scan everything being pushed.
root="$(git rev-parse --show-toplevel)"
zero="0000000000000000000000000000000000000000"
rc=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue            # branch deletion
  if [ "$remote_sha" = "$zero" ]; then base="$(git merge-base "$local_sha" origin/main 2>/dev/null || git hash-object -t tree /dev/null)"; else base="$remote_sha"; fi
  python3 "$root/tools/pii_scan.py" --range "$base..$local_sha" || rc=1
done
exit $rc
